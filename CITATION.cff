    affiliation: "Hermes Labs"
license: Apache-2.0
repository-code: "https://github.com/hermes-labs-ai/agent-gorgon"
version: "0.1.7"
keywords:
  - "AI reliability"
  - "agent safety"
  - "policy enforcement"
  - "runtime guard"
  - "forensic reporting"
